	"item": [
		{
			"name": "Obtener clientes",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"pm.test(\"Response is an array of clients\", function () {\r",
							"    pm.expect(pm.response.json()).to.be.an('array');\r",
							"});\r",
							"pm.test(\"Array is not empty and contains client objects\", function () {\r",
							"    const responseJson = pm.response.json();\r",
							"    pm.expect(responseJson.length).to.be.above(0);\r",
							"    if (responseJson.length > 0) {\r",
							"        pm.expect(responseJson[0]).to.have.property('id');\r",
							"        pm.expect(responseJson[0]).to.have.property('name');\r",
							"        // Agrega más propiedades que esperes en un cliente\r",
							"    }\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "mSqiBUjzz51YG5Q0OahqEP4rOrnwlIJLGKrktD6Le3d8edf8",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}api/clients",
					"host": [
						"{{baseUrl}}api"
					],
					"path": [
						"clients"
					]
				}
			},
			"response": []
		},
		{
			"name": "Borrar clientes",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 204 No Content or 200 OK\", function () {\r",
							"    // APIs a menudo devuelven 204 (No Content) para una eliminación exitosa sin cuerpo\r",
							"    // O 200 OK con un mensaje de confirmación\r",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 204]);\r",
							"});\r",
							"\r",
							"// Opcional: Verificar que el cliente ya no existe (requiere otra petición GET)\r",
							"pm.test(\"Client should no longer exist after deletion (verify with GET)\", function () {\r",
							"    pm.sendRequest({\r",
							"        url: pm.environment.get(\"baseUrl\") + \"/api/clients/\" + pm.environment.get(\"newlyCreatedClientId\"),\r",
							"        method: 'GET',\r",
							"        header: {\r",
							"            'Authorization': 'Bearer ' + pm.environment.get(\"bearerToken\")\r",
							"        }\r",
							"    }, function (err, res) {\r",
							"        pm.expect(res.code).to.be.oneOf([404, 200]); // Debería ser 404 Not Found si se eliminó\r",
							"        // Si la API devuelve 200 pero un cuerpo vacío/nulo para un ID no existente, también lo puedes validar\r",
							"    });\r",
							"});\r",
							"\r",
							"// Opcional: Limpiar la variable de entorno del ID si ya no se va a usar\r",
							"pm.environment.unset(\"newlyCreatedClientId\");"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
