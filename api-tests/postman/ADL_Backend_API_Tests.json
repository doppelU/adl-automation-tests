		{
			"name": "registro nuevo cliente",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201 Created\", function () {\r",
							"    pm.response.to.have.status(201);\r",
							"});\r",
							"\r",
							"pm.test(\"Response is JSON\", function () {\r",
							"    pm.response.to.be.json;\r",
							"});\r",
							"\r",
							"pm.test(\"Response body contains 'id' property\", function () {\r",
							"    const responseJson = pm.response.json();\r",
							"    pm.expect(responseJson).to.have.property('id');\r",
							"    pm.expect(responseJson.id).to.be.a('number'); // Asumiendo que el ID es un número\r",
							"});\r",
							"\r",
							"pm.test(\"Response body contains the correct name\", function () {\r",
							"    const responseJson = pm.response.json();\r",
							"    const requestBody = JSON.parse(pm.request.body.raw); // Obtener el body enviado\r",
							"    pm.expect(responseJson.name).to.eql(requestBody.name);\r",
							"});\r",
							"\r",
							"// Opcional: Guardar el ID del cliente creado para usarlo en otras peticiones (ej. GET o DELETE)\r",
							"pm.environment.set(\"newlyCreatedClientId\", pm.response.json().id);\r",
							"console.log(\"Newly Created Client ID:\", pm.environment.get(\"newlyCreatedClientId\"));"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
