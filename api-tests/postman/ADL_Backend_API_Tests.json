		{
			"name": "Actualizar clientes",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {\r",
							"    pm.response.to.have.status(200); // O 204 No Content si la API no devuelve cuerpo en PUT\r",
							"});\r",
							"\r",
							"pm.test(\"Response is JSON\", function () {\r",
							"    pm.response.to.be.json;\r",
							"});\r",
							"\r",
							"pm.test(\"Updated client name matches request\", function () {\r",
							"    const responseJson = pm.response.json();\r",
							"    const requestBody = JSON.parse(pm.request.body.raw);\r",
							"    pm.expect(responseJson.name).to.eql(requestBody.name);\r",
							"    pm.expect(responseJson.email).to.eql(requestBody.email);\r",
							"});\r",
							"\r",
							"pm.test(\"Updated client ID matches expected\", function () {\r",
							"    const responseJson = pm.response.json();\r",
							"    pm.expect(responseJson.id).to.eql(pm.environment.get(\"newlyCreatedClientId\"));\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
